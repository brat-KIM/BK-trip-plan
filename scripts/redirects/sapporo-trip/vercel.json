{
  "redirects": [
    { "source": "/((?!sw\\.js$).*)", "destination": "https://bk-trip-plan.vercel.app/sapporo", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
