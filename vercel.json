{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:slug([a-z0-9][a-z0-9-]*)", "destination": "/app/index.html" },
    { "source": "/:slug([a-z0-9][a-z0-9-]*)/", "destination": "/app/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/trips.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/trips/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
